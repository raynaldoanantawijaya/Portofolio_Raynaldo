---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import profileImage from '../assets/Foto/raynaldo.jpg';
import { defaultContent } from '../data/siteContent';
import { getSiteContent } from '../lib/firestoreService';
import ProjectSelector from '../components/ProjectSelector';

// Fetch content from Firestore at build/request time
let content = defaultContent;
try {
    content = await getSiteContent();
} catch (e) {
    console.error("Failed to fetch content from Firestore:", e);
}
// Set Cache-Control to cache at Edge for 1 hour
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=3600');
---

<Layout title="Portofolio Raynaldo Ananta Wijaya">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Raynaldo Ananta Wijaya",
      "alternateName": [
        "Ray", "Aldo", "Ray Wijaya", "Raynaldo Wijaya", "Ananta Wijaya", 
        "Raynaldo Ananta", "Ray Ananta", "Raynaldo Solo", "Aldo Solo", 
        "Raynaldo UMS", "Raynaldo Engineer", "Rynaldo", "Reynaldo", 
        "Raynald", "Pemuda Solo", "Tokoh Muda Solo"
      ],
      "description": "Electrical Engineer dan IoT Specialist dari Surakarta (Solo). Alumni Universitas Muhammadiyah Surakarta (UMS) dengan fokus pada Robotika, AI, dan Web Development.",
      "jobTitle": ["IoT Engineer", "Electrical Engineer", "Web Developer", "AI Enthusiast", "Robotics Researcher"],
      "url": "https://raynaldoanantawijaya.my.id/",
      "image": "https://raynaldoanantawijaya.my.id/assets/Foto/raynaldo.jpg",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Surakarta",
        "addressRegion": "Jawa Tengah",
        "addressCountry": "Indonesia"
      },
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "Universitas Muhammadiyah Surakarta",
        "sameAs": "https://www.ums.ac.id/"
      },
      "knowsAbout": [
        "Robotics", "Robotika", "Internet of Things (IoT)", "Embedded Systems", 
        "ESP32", "Arduino", "Artificial Intelligence", "Robot Research",
        "Web Development", "Astro", "React", "Python", "C++"
      ],
      "sameAs": [
        "https://github.com/raynaldoanantawijaya",
        "https://www.linkedin.com/in/raynaldo-ananta-wijaya-4934b2370",
        "https://www.instagram.com/raynaldo_ananta_wijaya",
        "https://youtube.com/@raynaldo99"
      ]
    }
    </script>

    <Header />

    <main>

    <section id="home">
        <div class="home-container">
            <div class="home-left fade-in">
                <h1>{content.hero.title}</h1>
                <p>{content.hero.description}</p>
                
                <div class="home-buttons">
                    <a href={content.hero.cvFile || "/assets/CV_RAYNALDO_ANANTA_WIJAYA.pdf"} id="btn-download-cv" class="btn btn-primary" download="CV_RAYNALDO_ANANTA_WIJAYA" target="_blank">
                        <svg viewBox="0 0 512 512" width="16" height="16" fill="currentColor" style="margin-right:8px"><path d="M288 32c0-17.7-14.3-32-32-32s-32 14.3-32 32V274.7l-73.4-73.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l128 128c12.5 12.5 32.8 12.5 45.3 0l128-128c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L288 274.7V32zM64 352c-17.7 0-32 14.3-32 32v32c0 53 43 96 96 96H384c53 0 96-43 96-96V384c0-17.7-14.3-32-32-32s-32 14.3-32 32v32c0 17.7-14.3 32-32 32H128c-17.7 0-32-14.3-32-32V384c0-17.7-14.3-32-32-32z"/></svg> <span>{content.hero.btnDownload}</span>
                    </a>
                    <a href="#projects" class="btn btn-secondary">
                        <svg viewBox="0 0 448 512" width="16" height="16" fill="currentColor" style="margin-right:8px"><path d="M201.4 374.6c12.5 12.5 32.8 12.5 45.3 0l160-160c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L224 306.7 86.6 169.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l160 160z"/></svg> <span>{content.hero.btnProjects}</span>
                    </a>
                </div>
            </div>
            <div class="home-right fade-in">
               <Image 
                   src={profileImage} 
                   alt="Foto Profil" 
                   class="profile-image" 
                   widths={[240, 320, 480, 600]}
                   sizes={`(max-width: 320px) 240px, (max-width: 480px) 320px, (max-width: 720px) 480px, 600px`}
                   quality={60}
                   format="webp"
                   loading="eager"
                   fetchpriority="high"
               />
            </div>
        </div>
    </section>

    <section id="about">
        <h2 class="section-title">{content.about.title}</h2>
        <div class="about-container">
            <div class="about-lightbox">
                <div class="about-description fade-in">
                    <p>{content.about.description}</p>
                </div>

                <div class="about-stats">
                    <div class="stat-item">
                        <div class="stat-number">
                            <span class="number">{content.about.stats.projects}</span>
                            <span class="plus">+</span>
                        </div>
                        <div class="stat-text">{content.about.stats.projectsLabel}</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-number">
                            <span class="number">{content.about.stats.experience}</span>
                            <span class="plus">+</span>
                        </div>
                        <div class="stat-text">{content.about.stats.experienceLabel}</div>
                    </div>
                </div>

                <div class="about-photo-small">
                     <Image 
                        src={profileImage} 
                        alt="Foto Kecil Profil" 
                        widths={[80, 160]}
                        sizes="80px"
                        quality={60}
                        format="webp"
                        class="about-photo-img"
                    />
                </div>
            </div>
            
            <div class="skills-section fade-in">
                <h3>{content.about.skillsTitle}</h3>
                <div class="skills-container" id="skills-container">
                    {content.skills.map((skill) => (
                        <div class="skill-item">
                            {skill.icon.startsWith('<svg') ? (
                                <div class="skill-icon" set:html={skill.icon} />
                            ) : (
                                <img src={skill.icon} alt={skill.title} class="skill-icon" />
                            )}
                            <div class="skill-info">
                                <div class="skill-title">{skill.title}</div>
                                <div class="skill-desc">{skill.desc}</div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <section id="projects">
        <h2 class="section-title">Proyek Saya</h2>
        {/* Pass initial projects to selector */}
        <ProjectSelector client:visible initialProjects={content.projects} />
    </section>

    <section id="contact">
        <h2 class="section-title">{content.contact.title}</h2>
        <div class="contact-container">
            <form class="contact-form fade-in" id="contact-form" action="https://formspree.io/f/xovkjolv" method="POST">
                <div class="form-group">
                    <label for="name">{content.contact.form.nameLabel}</label>
                    <input type="text" id="name" name="name" required />
                </div>
                <div class="form-group">
                    <label for="email">{content.contact.form.emailLabel}</label>
                    <input type="email" id="email" name="email" required />
                </div>
                <div class="form-group">
                    <label for="message">{content.contact.form.messageLabel}</label>
                    <textarea id="message" name="message" required></textarea>
                </div>
                <button type="submit" class="submit-btn" id="submit-btn">{content.contact.form.btnSubmit}</button>
            </form>
        </div>
    </section>

    </main>

    <Footer />
</Layout>

<script>
    const contactForm = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    
    if (contactForm && submitBtn) {
        const formInputs = contactForm.querySelectorAll('input, textarea');
        
        function checkFormValidity() {
            let allFilled = true;
            formInputs.forEach(input => {
                if (!(input as HTMLInputElement).value.trim()) {
                    allFilled = false;
                }
            });
            submitBtn.disabled = !allFilled;
        }
        
        formInputs.forEach(input => {
            input.addEventListener('input', checkFormValidity);
        });

        contactForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const originalText = submitBtn.textContent;
            submitBtn.textContent = 'Mengirim...';
            submitBtn.disabled = true;
            
            try {
                const formData = new FormData(contactForm);
                const response = await fetch('https://formspree.io/f/xovkjolv', {
                    method: 'POST',
                    body: formData,
                    headers: { 'Accept': 'application/json' }
                });
                
                if (response.ok) {
                    alert('Pesan Anda telah berhasil dikirim!');
                    contactForm.reset();
                    submitBtn.disabled = true;
                } else {
                    throw new Error('Gagal mengirim pesan');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Maaf, terjadi kesalahan. Silakan coba lagi.');
            } finally {
                submitBtn.textContent = originalText;
                submitBtn.disabled = false;
            }
        });
    }

    function observeElements(selector: string, className = 'visible', rootMargin = '0px 0px -200px 0px', delay = 300) {
        const elements = document.querySelectorAll(selector);
        const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry, index) => {
                if (entry.isIntersecting) {
                    setTimeout(() => {
                        entry.target.classList.add(className);
                    }, index * delay);
                    obs.unobserve(entry.target);
                }
            });
        }, { rootMargin });
        elements.forEach(el => observer.observe(el));
    }

    observeElements('.home-left.fade-in', 'visible', '0px 0px -200px 0px', 500);
    observeElements('.home-right.fade-in', 'visible', '0px 0px -200px 0px', 800);
    observeElements('.project-card.fade-in', 'visible', '0px 0px -200px 0px', 400);
    observeElements('.skill-item', 'visible', '0px 0px -200px 0px', 200);
    observeElements('.fade-in:not(.project-card):not(.skill-item)', 'visible', '0px 0px -200px 0px', 300);

    // ========================================
    // ADMIN CONTENT SYNC - Hydrate from localStorage
    // ========================================
    function syncAdminContent() {
        try {
            const stored = localStorage.getItem('site_content_v1');
            if (!stored) return;
            
            const data = JSON.parse(stored);
            
            // Helper to get nested value from path like "hero.title"
            function getNestedValue(obj: any, path: string): any {
                return path.split('.').reduce((current, key) => current?.[key], obj);
            }
            
            // Sync all data-sync elements
            document.querySelectorAll('[data-sync]').forEach(el => {
                const path = el.getAttribute('data-sync');
                if (path) {
                    const value = getNestedValue(data, path);
                    if (value !== undefined && value !== null) {
                        el.textContent = String(value);
                    }
                }
            });
            
            // Sync CV file
            const cvBtn = document.getElementById('btn-download-cv') as HTMLAnchorElement;
            if (cvBtn && data.hero?.cvFile) {
                cvBtn.href = data.hero.cvFile;
                // Always set to the user's preferred filename
                cvBtn.download = "CV_RAYNALDO_ANANTA_WIJAYA.pdf";
            }
            
            // Sync Skills
            const skillsContainer = document.getElementById('skills-container');
            if (skillsContainer && data.skills && Array.isArray(data.skills)) {
                skillsContainer.innerHTML = data.skills.map((skill: any) => `
                    <div class="skill-item">
                        <img src="${skill.icon}" alt="${skill.title}" class="skill-icon" />
                        <div class="skill-info">
                            <div class="skill-title">${skill.title}</div>
                            <div class="skill-desc">${skill.desc}</div>
                        </div>
                    </div>
                `).join('');
                
                // Re-observe skill items for animation
                observeElements('.skill-item', 'visible', '0px 0px -200px 0px', 200);
            }
            
            console.log('✅ Content synced from Admin Panel');
            
        } catch (e) {
            console.error("Failed to sync admin content:", e);
        }
    }
    
    // Run sync on page load
    syncAdminContent();
    
    // Observe project cards for animation (after React renders)
    function observeProjectCards() {
        const projectCards = document.querySelectorAll('.project-card');
        if (projectCards.length > 0) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                        observer.unobserve(entry.target);
                    }
                });
            }, { rootMargin: '0px 0px -100px 0px' });
            
            projectCards.forEach(card => observer.observe(card));
        }
    }
    
    // Run immediately and also after a delay to catch React hydration
    observeProjectCards();
    setTimeout(observeProjectCards, 500);
    setTimeout(observeProjectCards, 1500);
</script>
